# ---- App ----
APP_NAME=DataFactZ RAG Chatbot
ENV=local
API_KEY=change-me-dev-key            # sent as header: X-API-Key
CORS_ORIGINS=http://localhost:5173

# ---- Database ----
# Local dev uses SQLite. For "real" Azure deployment, point this at
# Azure Database for PostgreSQL and change the driver in db/session.py.
DATABASE_URL=sqlite:///./data/app.db

# ---- Vector backend ----
# "local"  -> numpy cosine-sim store on disk (data/vector_store.json), zero Azure cost, use for local dev
# "azure"  -> Azure AI Search (hybrid vector + keyword)
VECTOR_BACKEND=local

# ---- Azure AI Search (only needed when VECTOR_BACKEND=azure) ----
AZURE_SEARCH_ENDPOINT=https://<your-search-service>.search.windows.net
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX_NAME=contoso-kb

# ---- Embeddings ----
# "azure_v1"      -> current Azure OpenAI 'v1' API (host/openai/v1/...),
#                    Bearer-token auth. Use this if your project's sample
#                    code shows OpenAI(base_url=".../openai/v1", ...) —
#                    this is the confirmed format for AI_Training_Project.
# "azure_openai"  -> classic Azure OpenAI resource, one URL per deployment
# "azure_foundry" -> unified Foundry Models endpoint (.../models/chat/completions)
# "deepseek"      -> not currently available for embeddings, see embeddings.py
EMBEDDINGS_PROVIDER=azure_v1
EMBEDDINGS_MODEL=text-embedding-3-small
AZURE_OPENAI_ENDPOINT=https://<your-resource>.services.ai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-08-01-preview
AZURE_FOUNDRY_API_VERSION=2024-05-01-preview
AZURE_OPENAI_EMBEDDINGS_DEPLOYMENT=text-embedding-3-small

# ---- Generation LLM ----
# "azure_v1", "azure_openai", "azure_foundry", "claude", or "deepseek" —
# see the docstring at the top of app/services/generation.py for which
# one matches your Azure setup
GENERATION_PROVIDER=azure_v1
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-5.5

# DeepSeek reached through the SAME shared Azure AI Foundry connection above
# (reuses AZURE_OPENAI_ENDPOINT/AZURE_OPENAI_API_KEY, just a different
# deployment name) — set this to whatever exact deployment name your
# project's "View deployments" table shows for DeepSeek, then select it
# via the "provider": "azure_deepseek" field on a chat request (the
# frontend's model switcher does this for you).
AZURE_DEEPSEEK_DEPLOYMENT=DeepSeek-V3.2

# DeepSeek called directly from platform.deepseek.com (a separate account/
# key, NOT the Azure Foundry deployment above) — only fill this in if you
# specifically want to compare Azure-hosted vs. direct-from-DeepSeek.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Anthropic Claude (alternative generation provider)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# ---- Retrieval tuning ----
CHUNK_SIZE_TOKENS=350
CHUNK_OVERLAP_TOKENS=60
TOP_K=5
